{
  "name": "brutalita",
  "description": "Geometric font and web font editor.",
  "version": "0.3.0",
  "private": true,
  "homepage": "https://brutalita.com",
  "keywords": [
    "font",
    "otf",
    "opentype",
    "typeface",
    "font-editor",
    "cli"
  ],
  "bin": {
    "brutalita": "dist/cli/brutalita.mjs"
  },
  "files": [
    "dist/cli",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy": "vercel --prod",
    "cli": "tsx cli/index.ts",
    "build:cli": "tsx scripts/build-cli.ts",
    "test": "tsx --test \"cli/**/*.test.ts\" \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "fonts": "tsx cli/index.ts build src/font.json -d public -w all --filename \"Brutalita-{weight}.{ext}\"",
    "cover": "tsx scripts/update-cover.ts",
    "prepublishOnly": "pnpm build:cli"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/javierbyte/brutalita"
  },
  "author": "Javier Bórquez <hi@javier.xyz>",
  "license": "BSD-3-Clause",
  "dependencies": {},
  "devDependencies": {
    "@next/third-parties": "^16.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.30.0",
    "next": "^16.3.0",
    "opentype.js": "^2.0.0",
    "polygon-clipping": "^0.15.7",
    "postcss": "^8.5.26",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
